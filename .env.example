# Local Docker Compose database password (change this for your own machine)
DB_PASSWORD=change-me

# Gemini credentials are server-side only. A blank key prevents backend startup.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional custom Gemini-compatible endpoint. Blank uses LangChain4j's default.
LLM_BASE_URL=

# Local Docker Compose application port
SERVER_PORT=8080

# Optional CORS origin patterns. Add a production custom frontend origin when applicable.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://*.vercel.app
